enable
configure terminal
hostname GAROUA
no ip domain lookup
line console 0
 exec-timeout 0 0
 logging synchronous
 exit

int e0/0
 ip address 4.4.4.4 255.255.255.240
 description GAROUA -----> MAROUA          ! cf. NB 1
 no shutdown
int e0/1
 ip address 1.1.1.4 255.255.255.240
 description GAROUA -----> NGAOUNDERE      ! cf. NB 1
 no shutdown
 exit
int lo0
 ip address 22.22.22.22 255.255.255.255
 no shutdown


router ospf 4
 network 1.1.1.0 0.0.0.15 area 0
 network 4.4.4.0 0.0.0.15 area 0
 network 22.22.22.22 0.0.0.0 area 0



ip cef
mpls label range 200 299
mpls label protocol ldp
mpls ldp router-id loopback0

interface e0/0
 mpls ip
 exit
interface e0/1   
 mpls ip
 exit
