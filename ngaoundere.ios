enable
configure terminal
hostname NGAOUNDERE
no ip domain lookup
line console 0
 exec-timeout 0 0
 logging synchronous
 exit

int e0/1
 ip address 4.4.4.8 255.255.255.240
 description NGAOUNDERE -----> GAROUA
 no shutdown
int e0/0
 ip address 6.6.6.8 255.255.255.240
 description NGAOUNDERE -----> YAOUNDE
 no shutdown
 exit
int lo0
 ip address 77.77.77.77 255.255.255.255
 no shutdown
 exit

router ospf 8
 network 4.4.4.0 0.0.0.15 area 0
 network 6.6.6.0 0.0.0.15 area 0
 network 77.77.77.77 0.0.0.0 area 0


ip cef
mpls label range 700 799
mpls label protocol ldp
mpls ldp router-id loopback0
interface e0/1
 mpls ip
 exit
interface e0/0
 mpls ip
 exit
