enable
configure terminal
hostname BAFOUSSAM
no ip domain lookup
line console 0
 exec-timeout 0 0
 logging synchronous
 exit

int e0/0
 ip address 10.10.10.9 255.255.255.240
 description BAFOUSSAM -----> BAMENDA      ! cf. NB 1
 no shutdown
int lo0
 ip address 55.55.55.55 255.255.255.255
 no shutdown
 exit

router ospf 8
 network 10.10.10.0 0.0.0.15 area 0
 network 55.55.55.55 0.0.0.0 area 0



ip cef
mpls label range 500 599
mpls label protocol ldp
mpls ldp router-id loopback0
interface e0/0
 mpls ip
 exit
